{
  "name": "infodb-overlay-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @infodb/overlay --filter @infodb/overlay-web dev",
    "build": "pnpm --filter @infodb/overlay-web build && pnpm --filter @infodb/overlay build",
    "overlay": "node --no-experimental-webstorage --import tsx packages/overlay/src/cli/index.ts",
    "example": "pnpm --filter react-app-example dev",
    "test": "vitest run",
    "typecheck": "pnpm -r exec tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
