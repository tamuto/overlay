{
  "name": "overlay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @overlay/web --filter @overlay/cli dev",
    "build": "pnpm --filter @overlay/web build",
    "overlay": "node --no-experimental-webstorage --import tsx packages/cli/src/index.ts",
    "test": "vitest run",
    "typecheck": "pnpm -r exec tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
